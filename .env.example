# HabitOS — Environment Variables
# Frontend-first: la app funciona 100% sin backend.
# Estas variables solo se usan si activas auth/sync con Supabase.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HabitOS

# Opcional — Supabase (sync cuenta opcional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
